{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "resources": {
      "../target/release/coucou-hook.exe": null,
      "../target/release/coucou-hook": "coucou-hook"
    },
    "shortDescription": "Mochi lives at the top of your screen",
    "linux": {
      "deb": {
        "section": "devel",
        "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good"],
        "recommends": ["gnome-keyring | kwalletmanager | keepassxc", "xdg-utils", "tmux"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
